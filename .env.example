# Postgres connection string. Locally: run `pnpm db:local` and leave this as-is.
# Production: Neon (Vercel Marketplace → Neon) pooled connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Optional pipeline tuning
# BACKFILL_DAYS=45         # history pulled the first time a market is seen
# MIN_MARKET_VOLUME=10000  # skip stored history for thinly traded markets (charts fall back to live upstream)
