{
  "name": "midterm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:local": "pglite-server --db=.data/pglite --port=5432 --max-connections=10",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "pipeline": "tsx scripts/pipeline.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "p-limit": "^7.3.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@electric-sql/pglite-socket": "0.2.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.2"
}
